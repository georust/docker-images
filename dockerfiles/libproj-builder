# https://github.com/orgs/georust/packages/container/package/libproj-builder

# Builds libproj from source

ARG RUST_VERSION
FROM rust:$RUST_VERSION-slim-bookworm

ARG RUST_VERSION
ARG PROJ_VERSION
RUN test -n "$RUST_VERSION" || (echo "RUST_VERSION ARG not set" && false)
RUN test -n "$PROJ_VERSION" || (echo "PROJ_VERSION ARG not set" && false)

# Install dependencies
#
# The dev packages stay installed because the proj-ci images build PROJ from
# source with the `bundled_proj` feature and need them.
RUN apt-get update \
  && DEBIAN_FRONTEND="noninteractive" apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    g++ \
    git \
    libcurl4-gnutls-dev \
    libsqlite3-dev \
    libtiff-dev \
    make \
    pkg-config \
    sqlite3 \
    wget \
  && rm -rf /var/lib/apt/lists/*

# Compile and install to /build
#
# Note libproj is not installed to a system directory, so that a staged build
# can install from this container using something like:
#
#    # PROJ stage
#    FROM libproj-builder as libproj-builder
#    ...
#    # Maybe some additional stages
#    ...
#    # Output Container
#    FROM my-base-image
#    ...
#    COPY --from=libproj-builder /build/usr /usr
#    ...
#
# Download, build and remove the source in one layer so that the source tree
# does not remain in the image.
RUN wget -q https://github.com/OSGeo/PROJ/releases/download/${PROJ_VERSION}/proj-${PROJ_VERSION}.tar.gz \
  && tar -xzf proj-${PROJ_VERSION}.tar.gz \
  && mkdir proj-${PROJ_VERSION}/build \
  && cd proj-${PROJ_VERSION}/build \
  && cmake .. -DCMAKE_INSTALL_PREFIX=/build/usr -DBUILD_TESTING=OFF \
  && cmake --build . --target install -j $(nproc) \
  && cd / \
  && rm -fr proj-${PROJ_VERSION} proj-${PROJ_VERSION}.tar.gz
